{
  "name": "emd-agents",
  "version": "0.4.0",
  "description": "Build, run, check and prove mobile changes from any coding agent.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "emd": "dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check . && npm run check:imports && npm run check:unused && npm run check:duplicates",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:fast": "npm run build && vitest run",
    "test:e2e": "npm run build && EMD_E2E_SANDBOX=${EMD_E2E_SANDBOX:-$HOME/emd-sandbox} vitest run test/e2e",
    "check:sizes": "node --experimental-strip-types scripts/check-doc-sizes.ts",
    "check:imports": "node --experimental-strip-types scripts/check-imports.ts",
    "check:pr-title": "commitlint",
    "prepare": "husky",
    "check:unused": "knip",
    "check:duplicates": "jscpd"
  },
  "lint-staged": {
    "*.{ts,js,json}": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "husky": "^9.0.0",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "lint-staged": "^15.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  }
}
